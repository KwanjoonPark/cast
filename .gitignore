# python
__pycache__/
*.pyc
.pytest_cache/

# not versioned: paper PDFs, regenerable previews
papers/
paper_assets/previews/

# outputs/: keep experiment-level result tables, summaries and plots only.
# Per-run audio, latents, spectrograms and manifests are regenerable (fixed seeds, deterministic mode).
outputs/_*.log
outputs/**/*.wav
outputs/**/*.pt
outputs/**/spectrogram.png
outputs/**/manifest.json

# rewritten by every pytest run (random-init unit parity numbers); checkpoint-based parity files stay versioned
outputs/validation/unit_*.json

# reference materials for the assistant only (not shared)
참고자료/

# local virtualenv for the cast environment
.venv-cast/
.venv-cast-eval/
